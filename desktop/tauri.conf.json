{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio to MIDI Clock",
  "mainBinaryName": "audio-to-midi-clock",
  "version": "../package.json",
  "identifier": "io.github.jjurm.audio-to-midi-clock",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Audio to MIDI Clock",
        "width": 960,
        "height": 780,
        "minWidth": 380,
        "minHeight": 520,
        "backgroundColor": "#182039"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Live percussion to MIDI clock",
    "longDescription": "Listens to live percussion and sends MIDI clock that follows the player.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
